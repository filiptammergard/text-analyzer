{
	"name": "text-analyzer",
	"version": "3.0.1",
	"description": "Analyze text: count characters, words, sentences, paragraphs, and reading time",
	"keywords": [
		"text-analyzer",
		"text",
		"text-analysis",
		"characters",
		"words",
		"word-count",
		"reading-time"
	],
	"homepage": "https://github.com/filiptammergard/text-analyzer#readme",
	"bugs": {
		"url": "https://github.com/filiptammergard/text-analyzer/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/filiptammergard/text-analyzer.git"
	},
	"license": "MIT",
	"author": {
		"name": "Filip Tammergård",
		"email": "filip+npm@tammergard.se",
		"url": "https://tammergard.se"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts",
		"format": "prettier --write .",
		"format-check": "prettier --check .",
		"lint": "eslint .",
		"prepublishOnly": "pnpm build",
		"release": "pnpm changeset publish",
		"review": "pnpm install --frozen-lockfile && pnpm format-check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest --run",
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@tammergard/eslint-config-base": "^6.1.1",
		"@tammergard/prettier-config": "^3.0.2",
		"@tammergard/tsconfig": "^3.0.2",
		"eslint": "^10.8.1",
		"prettier": "^3.9.6",
		"tsdown": "^0.23.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
